# "max-paper" profile: maximise staked PAPER, cost per PAPER secondary.
#
# Owner plan ("tonight"): $4,000 wallet, BTC only, $1,000 loss budget from
# Sun 11 Oct 20:00 AEDT (09:00Z) to Tue 13 Oct 13:00 AEDT (02:00Z). Weekend
# BTC moves ~0.09%/h, so a fixed 1% close would take days per round; the
# volatility-matched mode sizes the close to the market instead.
#
# Use:  cp profiles/max-paper.env .env   then add the secrets and, only when
# ready, the three live flags. It stays DRY_RUN until you do.
# Every safety rule (never-naked-side, payout queue pause, relayer back-off,
# rule-change halt, stop conditions) is unchanged by this profile.

DRY_RUN=true
LIVE=false
LIVE_CONFIRM=

# secrets: fill in your local .env only, never here
WALLET_ADDRESS=
SESSION_KEY=
STAKE_WALLET_PRIVATE_KEY=

ENABLE_ETH=false

# Close distance d = 2 x realised hourly vol (last 6h, 15m Hyperliquid
# candles), clamped to 0.30-0.75%. Leverage = floor(min(1/(d + 0.30%),
# the take-profit <= 60% of liquidation rule, MAX_LEVERAGE)).
#   d 0.30% -> 100x at the default cap (166x if MAX_LEVERAGE >= 166)
#   d 0.50% -> 100x (113x uncapped; the 60% rule binds before 1/(d+0.3%)=125x)
#   d 0.75% -> 77x  (60% rule; 1/(d+0.3%) alone would be 95x)
# Without a vol reading (candles down > 1h) rounds use the widest close.
CLOSE_MODE=vol_matched
VOL_WINDOW_H=6
VOL_CANDLE_INTERVAL=15m
VOL_MULTIPLIER=2
CLOSE_MIN_PCT=0.30
CLOSE_MAX_PCT=0.75
VOL_LEVERAGE_BUFFER_PCT=0.30
TP_MAX_FRACTION_OF_LIQ=0.60
# 100 by default; may be raised explicitly up to ~170 (hard ceiling 200).
# The take-profit always stays inside liquidation (60% rule above).
MAX_LEVERAGE=100
# used only with CLOSE_MODE=fixed
LEVERAGE=40
TAKE_PROFIT_MOVE_PCT=1.0

# ~$1,400 per leg on a $4k wallet. Capped to (available - buffer) / 2, so
# full size holds while at least $3,000 is available (the whole $1k budget),
# then shrunk further if the tranche or daily budget cannot absorb the
# round's worst case.
MARGIN_PER_LEG_USD=1400
SIZE_FROM_BALANCE=true
BALANCE_BUFFER_USD=200
ROUND_COOLDOWN_S=0

MAX_COST_PER_PAPER=off
DAILY_LOSS_CAP_USD=1000
# Worst case at $1,400/leg, 100x, 0.30% (loser liquidated, winner closed at
# the same price) models at ~$250; x1.25 = ~$312 reserved per open round.
ROUND_COST_SAFETY_FACTOR=1.25

# Spend schedule: behind it, d tightens to CLOSE_MIN (within MAX_LEVERAGE).
# Spending = realized net losses of rounds closed since PACE_START.
PACE_START=2026-10-11T09:00:00Z
PACE_SCHEDULE=2026-10-12T01:00:00Z=450,2026-10-12T19:00:00Z=800

# Stop rules
#  - payout queue open: no new rounds (always on)
#  - LP < $1M: the standard tranche stops ...
#  - ... except the flat-100 band ($0.5M-$2M LP, queue empty), where the
#    opportunistic "remainder" tranche farms what is left in small rounds;
#    below $0.5M everything stops
#  - mint rate < 28: stop and keep the remaining budget
#  - closes slower than 3 min or overshooting (> half of the take-profit to
#    liquidation gap), twice in a row: lower leverage one step (max 2), then
#    pause 30 min; 5 clean closes restore one step
BUDGET_TRANCHES_FILE=profiles/tranches.example.json
LP_FLOOR_USD=1000000
OPPORTUNISTIC_LP_MIN_USD=500000
OPPORTUNISTIC_MARGIN_PER_LEG_USD=400
MIN_MINT_RATE=28
MINT_RATE_STOP=28
CLOSE_LATENCY_ALERT_S=180
CLOSE_LATENCY_ALERT_COUNT=2
CLOSE_OVERSHOOT_ALERT_FRACTION=0.5
LEVERAGE_DERATE_STEP_PCT=0.10
LEVERAGE_DERATE_MAX_STEPS=2
CLOSE_LATENCY_PAUSE_S=1800

STAKE_MODE=auto
STAKE_MIN_PAPER=1000

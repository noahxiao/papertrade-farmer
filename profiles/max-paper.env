# "max-paper" profile: maximise staked PAPER, cost per PAPER secondary.
#
# Owner decision: BTC only, 40x, both legs closed in one order at a 1% move,
# ~$2.5-3k margin per leg sized from balance, auto-stake after every round,
# losses bounded by a $1,000 daily cap and by budget tranches.
#
# Use:  cp profiles/max-paper.env .env   then add the secrets and, only when
# ready, the three live flags. It stays DRY_RUN until you do.
# Every safety rule (never-naked-side, payout queue pause, relayer back-off,
# rule-change halt, stop conditions) is unchanged by this profile.

DRY_RUN=true
LIVE=false
LIVE_CONFIRM=

# secrets: fill in your local .env only, never here
WALLET_ADDRESS=
SESSION_KEY=
STAKE_WALLET_PRIVATE_KEY=

ENABLE_ETH=false
LEVERAGE=40
TAKE_PROFIT_MOVE_PCT=1.0
TP_MAX_FRACTION_OF_LIQ=0.60

# Target margin; capped to (available balance - buffer) / 2, then shrunk
# further if the remaining tranche or daily budget cannot absorb the round's
# worst case. A $2,750 leg needs ~$5.6k available.
MARGIN_PER_LEG_USD=2750
SIZE_FROM_BALANCE=true
BALANCE_BUFFER_USD=50
ROUND_COOLDOWN_S=0

MAX_COST_PER_PAPER=off
DAILY_LOSS_CAP_USD=1000
# Worst case at $2,750/leg (loser liquidated, winner closed at the same
# price) models at ~$391. 1.25 lets a full-size round fit a fresh $500
# tranche; the default of 2 would shrink it to ~$1,760/leg. A whipsaw after
# a liquidation can exceed the modelled worst case; realized losses always
# count against the caps.
ROUND_COST_SAFETY_FACTOR=1.25

BUDGET_TRANCHES_FILE=profiles/tranches.example.json
MIN_MINT_RATE=28
OPPORTUNISTIC_LP_MIN_USD=500000
OPPORTUNISTIC_MARGIN_PER_LEG_USD=0

LP_FLOOR_USD=500000
MINT_RATE_STOP=20
CLOSE_LATENCY_ALERT_S=300
CLOSE_LATENCY_ALERT_COUNT=2

STAKE_MODE=auto
STAKE_MIN_PAPER=1000

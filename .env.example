# papertrade-farmer configuration. Copy to .env (gitignored) and edit.
# Every value below is the built-in default: this file is safe as-is and
# runs a DRY_RUN simulation that never touches the relayer.
# For the documented aggressive profile see profiles/max-paper.env.

# ---------------------------------------------------------------- mode
# Live trading needs all three: DRY_RUN=false, LIVE=true and the exact
# confirmation phrase. Anything in between is a configuration error.
DRY_RUN=true
LIVE=false
LIVE_CONFIRM=
# Run simulated rounds even when the cost / value-side gates say no
# (DRY_RUN only; ignored live). Useful to watch the loop work.
DRY_RUN_FORCE_ROUNDS=false
SIM_FILL_DELAY_S=30
SIM_START_BALANCE_USD=1000

# ---------------------------------------------------------------- secrets
# Never commit these. Live mode needs WALLET_ADDRESS and SESSION_KEY (a
# session key already registered for the wallet in the app).
WALLET_ADDRESS=
SESSION_KEY=
# Only for STAKE_MODE=auto in live mode. This is the WALLET key: it can
# also sign withdrawals. See README "Auto-staking custody".
STAKE_WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------- strategy
ENABLE_ETH=false
# fixed: LEVERAGE and TAKE_PROFIT_MOVE_PCT as set.
# vol_matched: close distance from realised BTC volatility, leverage derived
# from it (see the VOL_* block below and profiles/max-paper.env).
CLOSE_MODE=fixed
# Hard leverage cap for every mode. 100 by default; may be raised explicitly
# (ceiling 200) - the take-profit must still fit inside liquidation.
MAX_LEVERAGE=100
LEVERAGE=40
# Close both legs (one order) once the mid moved this far from entry.
TAKE_PROFIT_MOVE_PCT=1.0
# Take-profit may use at most this fraction of the liquidation distance.
TP_MAX_FRACTION_OF_LIQ=0.60
# Close early if the losing leg gets this close (in %) to its bust price
# (per round, never wider than half the take-profit-to-liquidation gap).
EMERGENCY_BUST_DISTANCE_PCT=0.30

# vol_matched only: d = clamp(VOL_MULTIPLIER x realised hourly vol over
# VOL_WINDOW_H, CLOSE_MIN_PCT, CLOSE_MAX_PCT); leverage = floor(min(
# 1/(d + VOL_LEVERAGE_BUFFER_PCT), TP <= TP_MAX_FRACTION_OF_LIQ, MAX_LEVERAGE)).
VOL_WINDOW_H=6
VOL_CANDLE_INTERVAL=15m
VOL_MULTIPLIER=2
CLOSE_MIN_PCT=0.30
CLOSE_MAX_PCT=0.75
VOL_LEVERAGE_BUFFER_PCT=0.30
# Each repeated slow/overshooting close widens the buffer by one step
# (lower leverage) before new rounds are paused.
LEVERAGE_DERATE_STEP_PCT=0.10
LEVERAGE_DERATE_MAX_STEPS=2
# Optional spend schedule (UTC=USD checkpoints); behind it, d = CLOSE_MIN_PCT.
PACE_START=
PACE_SCHEDULE=
MARGIN_PER_LEG_USD=250
SIZE_FROM_BALANCE=false
BALANCE_BUFFER_USD=50
ROUND_COOLDOWN_S=60

# ---------------------------------------------------------------- stops
# Estimated $ lost per PAPER minted, including expected mint-rate decay.
# "off" disables the gate (the daily loss cap then is the main stop).
MAX_COST_PER_PAPER=0.0016
# Realized loss today + worst case of open rounds + worst case of the next
# round must stay below this. Cannot be disabled.
DAILY_LOSS_CAP_USD=100
# Multiplier on the modelled worst case (loser liquidated) used by the
# budget pre-checks. Rounds are shrunk to fit the remaining budget.
ROUND_COST_SAFETY_FACTOR=2
LP_FLOOR_USD=500000
LP_TREND_HORIZON_H=2
MINT_RATE_STOP=20
MIN_MINT_RATE=28
CLOSE_LATENCY_ALERT_S=300
CLOSE_LATENCY_ALERT_COUNT=2
CLOSE_LATENCY_PAUSE_S=1800
# A close also counts as bad when its fills land more than this share of the
# way from the take-profit to liquidation (a liquidated loser counts as 1.0).
CLOSE_OVERSHOOT_ALERT_FRACTION=0.5

# ---------------------------------------------------------------- budget tranches
# Optional lifetime loss budgets with windows; see profiles/tranches.example.json.
# Set one of these, not both.
BUDGET_TRANCHES=
BUDGET_TRANCHES_FILE=
OPPORTUNISTIC_LP_MIN_USD=500000
# 0 = protocol minimum size for opportunistic (reserve) rounds.
OPPORTUNISTIC_MARGIN_PER_LEG_USD=0

# ---------------------------------------------------------------- value-side gates (advisory, off by default)
MIN_FEE_YIELD_PER_PAPER_DAY=off
MAX_PAYBACK_DAYS=off
MIN_LP_FRACTION_OF_CAP=off
REQUIRE_LP_TREND_NONNEGATIVE=false

# ---------------------------------------------------------------- staking
# off | remind (alert when PAPER is unstaked) | auto (stake after every round)
STAKE_MODE=remind
STAKE_MIN_PAPER=1000

# ---------------------------------------------------------------- relayer timing
LEG_FILL_TIMEOUT_S=1200
OPEN_ABANDON_TIMEOUT_S=1800
INTENT_GRACE_S=300
CLOSE_RESIGN_BEFORE_EXPIRY_S=600
SETTLE_GRACE_S=600
RELAYER_DOWN_HALT_S=1800
RELAYER_MAX_CONSECUTIVE_FAILURES=5

# ---------------------------------------------------------------- cost model inputs
BTC_DAILY_VOL_PCT=2.5
ETH_DAILY_VOL_PCT=3.5
EXPECTED_FILL_LATENCY_H=0.25
# Used until enough samples exist to measure tail growth.
TAIL_GROWTH_USD_PER_H=2170000

# ---------------------------------------------------------------- positions and shutdown
# Open positions the bot did not create: close | halt
UNKNOWN_POSITION_POLICY=close
FLATTEN_HEDGED_ON_SHUTDOWN=false
SHUTDOWN_GRACE_S=600

# ---------------------------------------------------------------- service
POLL_INTERVAL_S=10
RULE_CHECK_INTERVAL_S=900
DATA_DIR=./data
HEARTBEAT_PATH=./data/heartbeat.json
# Slack- or Discord-compatible incoming webhook (optional).
WEBHOOK_URL=
DAILY_SUMMARY_HOUR_UTC=0
EXCHANGE_ORIGIN=https://exchange.papertrade.xyz
RPC_URL=https://rpc.hyperliquid.xyz/evm
# Normally discovered from the frontend; set only to pin it.
PAPERTRADE_BUILD_ID=
